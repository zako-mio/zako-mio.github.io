---
import { DOMAIN_LABELS, TYPE_LABELS, type Project } from '../lib/schema';

export interface Props {
  project: Project;
}

const { project } = Astro.props;
const primaryUrl = project.has_pages ? project.entry_url : project.repo_url;
const typeLabel = TYPE_LABELS[project.type];
const domainLabels = project.domains.map((domain) => DOMAIN_LABELS[domain]);
const searchBlob = [
  project.title,
  project.name,
  project.summary,
  typeLabel,
  ...domainLabels,
  project.language ?? '',
]
  .join(' ')
  .toLowerCase();
---

<article
  class="card"
  data-project
  data-type={project.type}
  data-domains={project.domains.join(' ')}
  data-search={searchBlob}
>
  <div class="card__body">
    <ul class="card__tags">
      <li class="chip chip--type">{typeLabel}</li>
      {domainLabels.map((label) => <li class="chip">{label}</li>)}
    </ul>

    <h3 class="card__title">
      <a href={primaryUrl} rel="noopener noreferrer" target="_blank">
        {project.title}
      </a>
    </h3>

    <p class="card__summary">{project.summary}</p>
  </div>

  <footer class="card__footer">
    <p class="card__meta">
      {project.language && <span class="card__lang">{project.language}</span>}
      {
        typeof project.stars === 'number' && (
          <span class="card__stars" aria-label={`${project.stars} stars`}>
            ★ {project.stars}
          </span>
        )
      }
      {
        !project.has_pages && (
          <span class="chip chip--warning" title="未启用 GitHub Pages，仅提供仓库入口">
            仅仓库
          </span>
        )
      }
    </p>
    <p class="card__links">
      <a href={primaryUrl} rel="noopener noreferrer" target="_blank">
        {project.has_pages ? '在线预览' : '仓库'}
      </a>
      {project.has_pages && (
        <a href={project.repo_url} rel="noopener noreferrer" target="_blank">
          仓库
        </a>
      )}
    </p>
  </footer>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-4);
    background: var(--surface);
    border: 1px solid var(--control-border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease,
      border-color 0.15s ease;
  }

  .card:hover,
  .card:focus-within {
    transform: translateY(-2px);
    border-color: var(--accent);
    box-shadow: var(--shadow-card-hover);
  }

  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-bottom: var(--space-2);
  }

  .chip--type {
    color: var(--text);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    border-color: color-mix(in srgb, var(--accent) 35%, transparent);
  }

  .card__title {
    font-size: var(--fs-card-title);
    font-weight: 600;
    line-height: 1.3;
    color: var(--text);
  }

  .card__title a {
    color: inherit;
    text-decoration: none;
  }

  .card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }

  .card:hover .card__title a {
    color: var(--accent);
  }

  .card__summary {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .card__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    border-top: 1px solid var(--border);
    padding-top: var(--space-3);
  }

  .card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--fs-label);
    color: var(--text-secondary);
  }

  .card__lang {
    font-family: var(--font-mono);
  }

  .card__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    font-size: var(--fs-label);
  }

  .card__links a {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    font-weight: 500;
  }

  @media (prefers-reduced-motion: reduce) {
    .card {
      transition: none;
    }

    .card:hover,
    .card:focus-within {
      transform: none;
    }
  }
</style>
