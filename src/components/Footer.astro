---
export interface Props {
  displayName: string;
  generatedAt?: string | null;
  runId?: string | null;
}

const { displayName, generatedAt = null, runId = null } = Astro.props;
const year = new Date().getFullYear();
const github = 'https://github.com/zako-mio';

const sitemap = [
  { href: '#top', label: '首页' },
  { href: '#about', label: '关于' },
  { href: '#projects', label: '项目' },
  { href: '#contact', label: '联系' },
];
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__top">
      <nav class="footer__sitemap" aria-label="站点地图">
        {
          sitemap.map((item) => (
            <a class="footer__link" href={item.href}>
              {item.label}
            </a>
          ))
        }
      </nav>
      <a class="footer__top-link" href="#top">回到顶部 ↑</a>
    </div>
    <p class="footer__copy">
      © {year} {displayName} · 内容以各项目仓库为准 ·
      <a href={github} rel="noopener noreferrer" target="_blank">GitHub</a>
    </p>
    <p class="footer__meta">
      {generatedAt && <span data-generated-at>数据更新：{generatedAt}</span>}
      {runId && <span data-run-id> · build {runId}</span>}
    </p>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--space-7);
    border-top: 1px solid var(--border);
    padding-block: var(--space-5);
    background: var(--surface);
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    font-size: var(--fs-label);
    color: var(--text-secondary);
  }

  .footer__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    width: 100%;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border);
  }

  .footer__sitemap {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .footer__link,
  .footer__top-link {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    font-weight: 500;
  }

  .footer__copy,
  .footer__meta {
    line-height: 1.6;
  }

  .footer a {
    color: var(--accent);
  }
</style>
